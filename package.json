{
  "name": "isp-ui-kit",
  "version": "3.0.0",
  "description": "React UI kit for admin interfaces built with Ant Design, with layouts, form fields, data tables and JSON tools.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./search": {
      "import": {
        "types": "./dist/search.d.mts",
        "default": "./dist/search.mjs"
      },
      "require": {
        "types": "./dist/entries/search.d.ts",
        "default": "./dist/search.cjs"
      }
    },
    "./json-viewer": {
      "import": {
        "types": "./dist/json-viewer.d.mts",
        "default": "./dist/json-viewer.mjs"
      },
      "require": {
        "types": "./dist/entries/json-viewer.d.ts",
        "default": "./dist/json-viewer.cjs"
      }
    },
    "./code-editor": {
      "import": {
        "types": "./dist/code-editor.d.mts",
        "default": "./dist/code-editor.mjs"
      },
      "require": {
        "types": "./dist/entries/code-editor.d.ts",
        "default": "./dist/code-editor.cjs"
      }
    },
    "./code-editor/custom": {
      "import": {
        "types": "./dist/code-editor-custom.d.mts",
        "default": "./dist/code-editor-custom.mjs"
      },
      "require": {
        "types": "./dist/entries/code-editor-custom.d.ts",
        "default": "./dist/code-editor-custom.cjs"
      }
    }
  },
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.css.mjs",
    "*.scss.mjs"
  ],
  "license": "MIT",
  "repository": {
    "url": "https://github.com/txix-open/isp-ui-kit"
  },
  "keywords": [
    "react",
    "antd",
    "ui-kit",
    "admin",
    "forms"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "docs/auth-hook.md",
    "docs/code-editor.md",
    "docs/design-system.md",
    "docs/layout-navigation.md",
    "docs/layout-pages.md",
    "docs/migration.md",
    "docs/react-json-view-rewrite.md",
    "docs/redesign-plan.md"
  ],
  "dependencies": {
    "dayjs": "^1.11.23",
    "react-base16-styling": "~0.10.1",
    "react-resizable": "^3.1.3",
    "react-textarea-autosize": "~8.5.9",
    "simplebar-react": "^3.3.2"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.2",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@monaco-editor/react": "^4.7.0",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-resizable": "^3.0.8",
    "antd": "^6.3.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "rollup": "^4.60.3",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.99.0",
    "storybook": "^10.3.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "antd": ">=6",
    "monaco-editor": "^0.55.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": "^7.67.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.3"
  },
  "scripts": {
    "build": "rollup -c",
    "check:package": "node scripts/check-package.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npx prettier --write",
      "npx eslint --fix"
    ]
  }
}
